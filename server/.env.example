PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_community

# JWT（生产务必使用 32+ 字符随机串；默认有效期 3 天）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3d

# 生产环境必须设置具体域名，逗号分隔；开发环境留空则允许本地调试
CORS_ORIGIN=
# 位于 Nginx 后时设为 1
TRUST_PROXY_HOPS=1
# 生产配置不合规时是否拒绝启动（1=拒绝）
SECURITY_STRICT_STARTUP=0

PUBLIC_BASE_URL=http://localhost:3000
SMS_DEV_CODE=1234
SMS_SEND_INTERVAL_SEC=60
# 验证码错误 N 次锁定（默认 5 次 / 30 分钟）
SMS_VERIFY_MAX_FAIL=5
SMS_VERIFY_LOCK_MIN=30
# 每 IP 每日最多发码次数
SMS_IP_DAILY_MAX=20

WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_DEV_MODE=0
WECHAT_DEV_OPENID=dev_openid_001

PNVS_ENABLED=0
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
PNVS_ENDPOINT=dypnsapi.aliyuncs.com
PNVS_SIGN_NAME=
PNVS_TEMPLATE_CODE_LOGIN=100001
PNVS_TEMPLATE_CODE_BIND=100004
PNVS_CODE_LENGTH=6
PNVS_VALID_TIME=300
PNVS_SEND_INTERVAL=60

# Redis（可选；多实例部署强烈建议配置，用于限流与 JWT 黑名单）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://:password@127.0.0.1:6379

# 内容安全
CONTENT_MODERATION=on
# 生产建议 1：动态图片仅允许 OSS/自有域名
STRICT_MEDIA_URLS=0
MEDIA_ALLOWED_HOSTS=
ALLOW_LOCAL_MEDIA_URLS=1
# 新注册用户 N 小时内禁止 UGC（0=关闭）
NEW_USER_UGC_HOURS=24
# 生产建议 1：发帖/评论等需绑定手机号
REQUIRE_PHONE_FOR_UGC=0
# 追加敏感词，逗号分隔
SENSITIVE_WORDS=

DEFAULT_USER_AVATAR=/static/images/avatar-default.png

OSS_ENABLED=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_KEY_PREFIX=pet-community/

ADMIN_PHONE=13800000000
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=系统管理员
