PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_community
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# 生产环境必须设置具体域名，逗号分隔；开发环境留空则允许本地调试
CORS_ORIGIN=
PUBLIC_BASE_URL=http://localhost:3000
SMS_DEV_CODE=1234
# 同一手机号发送验证码最小间隔（秒），与前端倒计时一致
SMS_SEND_INTERVAL_SEC=60
WECHAT_APPID=
WECHAT_APPSECRET=
# 仅未配置 WECHAT_APPID/SECRET 时兜底
WECHAT_DEV_MODE=0
WECHAT_DEV_OPENID=dev_openid_001

# 阿里云号码认证 PNVS（短信验证码，生产环境 PNVS_ENABLED=1）
PNVS_ENABLED=0
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
PNVS_ENDPOINT=dypnsapi.aliyuncs.com
PNVS_SIGN_NAME=
PNVS_TEMPLATE_CODE_LOGIN=100001
PNVS_TEMPLATE_CODE_BIND=100004
PNVS_CODE_LENGTH=4
PNVS_VALID_TIME=300
PNVS_SEND_INTERVAL=60
DEFAULT_USER_AVATAR=/static/images/avatar-default.png

# 阿里云 OSS（字段对应 logistics 的 sky.alioss；配齐后上传走 OSS，否则落盘 uploads/）
# OSS_ENABLED=false 可强制走本地
OSS_ENABLED=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_KEY_PREFIX=pet-community/
ADMIN_PHONE=13800000000
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=系统管理员
