PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_community
JWT_SECRET=pet-community-dev-secret
JWT_EXPIRES_IN=7d
PUBLIC_BASE_URL=http://localhost:3000
SMS_DEV_CODE=1234
WECHAT_APPID=
WECHAT_APPSECRET=
# 仅未配置 WECHAT_APPID/SECRET 时兜底；已配置则始终调用微信接口换号
WECHAT_DEV_MODE=0
WECHAT_DEV_PHONE=13800138001
DEFAULT_USER_AVATAR=/static/images/avatar-default.png

# 阿里云 OSS（字段对应 logistics 的 sky.alioss；配齐后上传走 OSS，否则落盘 uploads/）
# OSS_ENABLED=false 可强制走本地
OSS_ENABLED=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_KEY_PREFIX=pet-community/
ADMIN_PHONE=13800000000
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=系统管理员
