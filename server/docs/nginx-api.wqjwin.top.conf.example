# api.wqjwin.top — 最简稳定版
#
# 若 Response 出现 nginx 403 HTML（Status 可能是 403 或被宝塔改成 200）：
# 多半是请求进了 server_name _ 默认站点，没有 /api/ 反代。
# 解决：在默认站点也加 location /api/ 反代，或删掉多余 443 默认站。
# 排查：nginx -T | grep -B5 -A30 'server_name _'
#
# api.wqjwin.top — 最简稳定版（解决 Postman read ECONNRESET）
#
# ECONNRESET 常见原因：upstream keepalive 复用了 Node 已关闭的连接。
# 本版去掉 upstream/keepalive，优先稳定性。
#
# 宝塔 → 网站 → api.wqjwin.top → 配置文件 → 整段替换（不要粘贴 # 注释行）

server {
    listen 80;
    server_name api.wqjwin.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.wqjwin.top;

    ssl_certificate     /www/server/panel/vhost/cert/api.wqjwin.top/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/api.wqjwin.top/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:api_wqjwin:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_buffer_size 8k;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 20m;

    access_log /www/wwwlogs/api.wqjwin.top.log;
    error_log  /www/wwwlogs/api.wqjwin.top.error.log;

    location /api/ {
        proxy_pass http://127.0.0.1:3000/api/;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store" always;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /ws {
        proxy_pass http://127.0.0.1:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3000/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location ~ /\.well-known {
        allow all;
    }
}
